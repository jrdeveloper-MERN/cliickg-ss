# Production Deployment Template (.env.production.example)
PORT=5001
NODE_ENV=production
DATABASE_URL=postgresql://production_user:production_password@production-host:5432/DB?schema=public
JWT_SECRET=production_jwt_secret_key_from_vault
ALLOWED_ORIGINS=https://your-store-domain.com,https://your-admin-domain.com

# Redis Production Configuration
REDIS_HOST=production-redis-cluster
REDIS_PORT=6379
REDIS_PASSWORD=production_redis_password

# SMS Gateway Production Setup (Strict Production - NO FAKE OTP ALLOWED)
SMS_GATEWAY_MODE=PRODUCTION
SMS_GATEWAY_PROVIDER=smartping
DEV_FAKE_OTP_ENABLED=false
DEV_FAKE_OTP_CODE=

# SmartPing Production Gateway Secrets (Injected dynamically via AWS Secrets Manager / Vault)
SMARTPING_API_URL=https://pgapi.smartping.ai/fe/api/v1/send
SMARTPING_USERNAME=<SMARTPING_USERNAME>
SMARTPING_PASSWORD=<SMARTPING_PASSWORD>
SMARTPING_SENDER_ID=<SMARTPING_SENDER_ID>
SMARTPING_DLT_ID=<SMARTPING_DLT_ID>
SMARTPING_OTP_MESSAGE="Your OTP is {otp}. Do not share it with anyone. It is valid for 15 minutes. – Yetlo Tech Private Limited"
