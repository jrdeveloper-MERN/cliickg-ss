# Local Development Template Example (.env.example)
PORT=5001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:12345@127.0.0.1:5432/CliickG-DB?schema=public"
JWT_SECRET=your_jwt_secret_key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5001

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS Gateway Configuration
SMS_GATEWAY_MODE=MOCK
SMS_GATEWAY_PROVIDER=mock
DEV_FAKE_OTP_ENABLED=true
DEV_FAKE_OTP_CODE=12345

# SmartPing Gateway Placeholders
SMARTPING_API_URL=https://pgapi.smartping.ai/fe/api/v1/send
SMARTPING_USERNAME=<SMARTPING_USERNAME>
SMARTPING_PASSWORD=<SMARTPING_PASSWORD>
SMARTPING_SENDER_ID=<SMARTPING_SENDER_ID>
SMARTPING_DLT_ID=<SMARTPING_DLT_ID>
SMARTPING_OTP_MESSAGE="Your OTP is {otp}. Do not share it with anyone. It is valid for 15 minutes. – Yetlo Tech Private Limited"
